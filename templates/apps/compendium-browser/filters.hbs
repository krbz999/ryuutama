<section>
  <div class="content">
    <div class="types">
      {{#each documentNameButtons}}
      <a data-action="changeDocumentType" {{#if active}} class="active" {{/if}} data-document-name="{{documentName}}" {{disabled ../lockType}}>
        <ryuutama-icon src="{{icon}}" inert></ryuutama-icon>
        <span>{{label}}</span>
      </a>
      {{/each}}
    </div>

    {{#each filters}}
    {{#if label}}
    <h3 class="label">{{label}}</h3>
    {{/if}}

    {{!-- TEXT --}}
    {{#if (eq type "text")}}
    <div class="filter text">
      <input type="{{input.type}}" data-filter="{{name}}" placeholder="{{input.placeholder}}" data-type="text" value="{{input.value}}" {{disabled input.isLocked}} data-change="input" id="{{rootId}}-{{name}}">
    </div>
    {{/if}}

    {{!-- CHECKBOXES --}}
    {{#if (eq type "checkboxes")}}
    <div class="filter checkboxes">
      {{#each options}}
      <a data-action="adjustFilter" data-filter="{{../name}}" data-type="checkboxes" data-value="{{value}}" {{disabled isLocked}}>
        <i class="fa-fw {{icon}}" inert></i>
        <span>{{label}}</span>
      </a>
      {{/each}}
    </div>
    {{/if}}

    {{!-- RANGE --}}
    {{#if (eq type "range")}}
    <div class="filter range">
      <input type="number" data-filter="{{name}}" data-value="min" data-type="range" value="{{range.min}}" placeholder="{{range.minPh}}" {{disabled range.minLocked}} data-change="change" id="{{rootId}}-{{name}}.min">
      <span class="sep"></span>
      <input type="number" data-filter="{{name}}" data-value="max" data-type="range" value="{{range.max}}" placeholder="{{range.maxPh}}" {{disabled range.maxLocked}} data-change="change" id="{{rootId}}-{{name}}.max">
    </div>
    {{/if}}

    {{/each}}
  </div>
</section>
