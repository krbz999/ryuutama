<section data-tab="{{tabs.rations.id}}" data-group="{{tabs.rations.group}}" class="{{tabs.rations.cssClass}}">
  <div class="contents">
    {{#if rations.isEmpty}}
    <div class="notification info empty">
      <div>
        <p>{{localize "RYUUTAMA.ACTOR.PARTY.rationsHintEmptyA"}}</p>
        <p>{{localize "RYUUTAMA.ACTOR.PARTY.rationsHintEmptyB"}}</p>
      </div>
    </div>
    {{else}}

    {{#if rations.missingFood}}
    <div class="notification warning empty">{{localize "RYUUTAMA.ACTOR.PARTY.rationsHintMissingFood"}}</div>
    {{/if}}

    {{#if rations.missingWater}}
    <div class="notification warning empty">{{localize "RYUUTAMA.ACTOR.PARTY.rationsHintMissingWater"}}</div>
    {{/if}}

    {{#if (and rations.hasAnimals rations.missingFeed)}}
    <div class="notification warning empty">{{localize "RYUUTAMA.ACTOR.PARTY.rationsHintMissingFeed"}}</div>
    {{/if}}

    <section class="rations">
      {{#each rations.rations as |category|}}
      {{#if category.rations.length}}
      <h3>{{category.label}} ({{category.rations.length}})</h3>
      <section class="ration-category" data-type="{{category.type}}" data-tooltip-direction="UP">
        {{#each category.rations}}
        <div class="ration {{cssClass}}" data-container-uuid="{{container.uuid}}" data-ration-id="{{id}}" data-tooltip-html="{{tooltip}}">
          <ryuutama-icon src="{{icon}}" inert></ryuutama-icon>
          {{#unless disabled}}
          <a class="control" data-action="consumeRation">
            <i class="fa-solid fa-fw fa-times" inert></i>
          </a>
          {{/unless}}
        </div>
        {{/each}}
      </section>
      {{/if}}
      {{/each}}
    </section>
    {{/if}}
  </div>
</section>
